# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Nancy's backend. Mohamed's runs on 3001, Momen's on 3002, the frontend on 3000.
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Mohamed's inventory-service (stock is set to 0 through its API when food is discarded)
INVENTORY_API_URL=http://localhost:3001

# Neon connection string for THIS backend's own login (alerts_service, see database/roles.sql). sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# The SAME value as Momen's auth service (it signs tokens, we verify). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=


# --- AWS / Floci ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
REPORTS_BUCKET=foodbank-reports
CW_LOG_GROUP=/foodbank/api
CW_METRICS_ENABLED=true
# true = read DATABASE_URL, JWT_SECRET and SMTP_* from Secrets Manager instead of this file
USE_SECRETS_MANAGER=false
APP_SECRET_ID=foodbank/nancy/app
SMTP_SECRET_ID=foodbank/nancy/smtp

# --- External email (SMTP provider, e.g. Brevo / Mailtrap / Gmail app password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Food Bank Alerts <your-verified-sender@example.com>
