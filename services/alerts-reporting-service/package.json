{
  "name": "alerts-reporting-service",
  "version": "1.0.0",
  "description": "Expiry Alerts & Reporting backend (Nancy)",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "token": "node scripts/test-token.js",
    "test": "jest --runInBand",
    "smoke": "node scripts/smoke-test.js",
    "floci:setup": "node scripts/floci-setup.js",
    "floci:check": "node scripts/floci-check.js",
    "floci:deploy": "node scripts/floci-setup.js --with-lambda"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1175.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1175.0",
    "@aws-sdk/client-lambda": "^3.1175.0",
    "@aws-sdk/client-scheduler": "^3.1175.0",
    "archiver": "^7.0.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
