# Copy to database/.env (git-ignored). Use the Neon OWNER connection string (neondb_owner):
# only this one-time setup needs to create tables. The backends use their own restricted logins.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require

# Passwords for the demo users created by `npm run seed` (choose your own, at least 10 characters)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
